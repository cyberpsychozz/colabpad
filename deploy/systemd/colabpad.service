[Unit]
Description=ColabPad (FastAPI + Socket.IO)
After=network.target

[Service]
User=colabpad
Group=colabpad
WorkingDirectory=/opt/colabpad
EnvironmentFile=/etc/colabpad/colabpad.env
ExecStart=/opt/colabpad/.venv/bin/uvicorn app.main:asgi --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --log-level warning
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/colabpad
UMask=0077

[Install]
WantedBy=multi-user.target
