[Unit]
Description=CollabPad (FastAPI + Socket.IO)
After=network.target

[Service]
User=collabpad
Group=collabpad
WorkingDirectory=/opt/collabpad
EnvironmentFile=/etc/collabpad/collabpad.env
ExecStart=/opt/collabpad/.venv/bin/uvicorn app.main:asgi --host 127.0.0.1 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --log-level warning --timeout-graceful-shutdown 20
# Stop signals go to Uvicorn only: it asks the simulation process to save the world and
# stop. Killing the whole group at once would lose up to 5 s of the world.
KillMode=mixed
TimeoutStopSec=40
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/collabpad
UMask=0077

[Install]
WantedBy=multi-user.target
