[Unit]
Description=CollabPad (FastAPI + Socket.IO)
After=network.target

[Service]
User=collabpad
Group=collabpad
WorkingDirectory=/opt/collabpad
EnvironmentFile=/etc/collabpad/collabpad.env
ExecStart=/opt/collabpad/.venv/bin/uvicorn app.main:asgi --host 127.0.0.1 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --log-level warning
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/collabpad
UMask=0077

[Install]
WantedBy=multi-user.target
