# Port the app listens on (127.0.0.1 only). Must match the upstream in the nginx config.
PORT=8000
DATA_DIR=/var/lib/collabpad
PUBLIC_URL=https://collabpad.ru
VLM_API_KEY=
# ЮKassa TEST shop only.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CORS_ORIGINS=https://collabpad.ru
MAX_POINTS_PER_STROKE=2000
MAX_PAYLOAD_BYTES=65536
BRUSH_WIDTH_MIN=1
BRUSH_WIDTH_MAX=40
SIMPLIFY_EPSILON=0.5
PALETTE="#000000,#FFFFFF,#E53935,#FB8C00,#FDD835,#43A047,#1E88E5,#8E24AA"
ADS_BLOCK_SIDE=
ADS_BLOCK_BOTTOM=
