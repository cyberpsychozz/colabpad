# Port the app listens on (127.0.0.1 only). Must match the upstream in the nginx config.
PORT=8000
DATA_DIR=/var/lib/collabpad
# Public origin: used in sign-in mail links and as the payment return address.
PUBLIC_URL=https://collabpad.ru
# Sign-in and invitation mail, implicit TLS. Empty SMTP_HOST: mail is only written to the log.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# OpenRouter-compatible key. Empty: ALIVE shows the manual type grid. Daily cap: config/vlm.yaml.
VLM_API_KEY=
# ЮKassa TEST shop only.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CORS_ORIGINS=https://collabpad.ru
MAX_POINTS_PER_STROKE=2000
MAX_PAYLOAD_BYTES=65536
BRUSH_WIDTH_MIN=1
BRUSH_WIDTH_MAX=40
SIMPLIFY_EPSILON=0.5
PALETTE="#000000,#FFFFFF,#E53935,#FB8C00,#FDD835,#43A047,#1E88E5,#8E24AA"
# RSYa ad block ids (R-A-...). Ads show only when config/flags.yaml has ads.enabled: true.
ADS_BLOCK_SIDE=
ADS_BLOCK_BOTTOM=
# How often the simulation logs its tick times (seconds).
SIM_STATS_INTERVAL_S=60
