# Port for ./start.sh (local development without Docker).
PORT=8000
# Docker: the host port the app is published on (127.0.0.1 only; host Nginx proxies to it).
# The application inside the container always uses 8000.
COLLABPAD_PORT=1744
# SQLite (DATA_DIR/collabpad.db) and baked sprites (DATA_DIR/sprites) live here.
DATA_DIR=./data
# Public origin, used in e-mail links and payment return URLs.
PUBLIC_URL=http://localhost:8000
# Login mail via implicit TLS
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# VLM key (OpenRouter-compatible). Empty: ALIVE falls back to the manual type grid.
VLM_API_KEY=
# HTTP proxy for the VLM calls only (Robokassa and mail never use it). Empty: direct.
# With the Compose "egress" profile: http://vlm-egress:1055.
VLM_PROXY_URL=
# Compose "egress" profile: COMPOSE_PROFILES=egress makes every docker compose command
# include it. TS_AUTHKEY: a tagged, reusable Tailscale auth key; TS_EXIT_NODE: the exit node's
# Tailscale IP or name.
COMPOSE_PROFILES=
TS_AUTHKEY=
TS_EXIT_NODE=
# Robokassa, TEST mode only: the shop identifier and the TEST passwords #1 and #2 from
# Technical settings → test mode. Never put the production passwords here.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
# The signature hash set in the shop's technical settings: md5, sha1, sha256, sha384 or sha512.
ROBOKASSA_HASH=md5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_POINTS_PER_STROKE=2000
MAX_PAYLOAD_BYTES=65536
BRUSH_WIDTH_MIN=1
BRUSH_WIDTH_MAX=40
SIMPLIFY_EPSILON=0.5
PALETTE="#000000,#FFFFFF,#E53935,#FB8C00,#FDD835,#43A047,#1E88E5,#8E24AA"
# RSYa ad block ids (R-A-…), e.g. R-A-20462150-1. The side block is shown four times on desktop
# (two stacked on each side). Ads show only when config/flags.yaml has ads.enabled: true.
ADS_BLOCK_SIDE=
ADS_BLOCK_BOTTOM=
