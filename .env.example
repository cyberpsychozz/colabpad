PORT=8000
# Docker host port; the application inside the container always uses 8000.
COLLABPAD_PORT=8000
DB_PATH=./data/collabpad.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CANVAS_WIDTH=1600
CANVAS_HEIGHT=1000
MAX_STROKES_PER_CANVAS=5000
MAX_POINTS_PER_STROKE=2000
MAX_PAYLOAD_BYTES=65536
MAX_CLIENTS_PER_CANVAS=20
STROKE_RATE_LIMIT=30/10
CANVAS_CREATE_LIMIT=10/60
BRUSH_WIDTH_MIN=1
BRUSH_WIDTH_MAX=40
SIMPLIFY_EPSILON=0.5
NAME_MAX_LEN=30
PALETTE="#000000,#FFFFFF,#E53935,#FB8C00,#FDD835,#43A047,#1E88E5,#8E24AA"
