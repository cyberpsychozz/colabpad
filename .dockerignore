# Allow only build inputs; local databases, credentials and Git stay on the host.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app/
!app/**
!config/
!config/**
!prompts/
!prompts/**
!web/
!web/**
# Shared Python/JavaScript choreography fixture used by frontend tests.
!tests/
!tests/golden/
!tests/golden/choreography.json
!deploy/
!deploy/backup.py
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
web/node_modules/
app/static/
